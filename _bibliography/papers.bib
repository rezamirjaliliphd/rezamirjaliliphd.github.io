@unpublished{smoothsurrogates,
  abbr={In preparation},
  title={Delayed Floor Smoothing and Chvátal–Gomory Closures of Packing Polyhedra},
  author={Mirjalili, Reza and Lim, Gino J.},
  year={2026},
  note={Manuscript in preparation for Operations Research Letters},
  selected={true},
  bibtex_show={true},
  abstract={Smooth surrogates of the floor function are used to train cut-generating and value-function networks for integer programs by gradient methods. We ask which cutting planes such surrogates can produce without losing validity. For packing polyhedra P = {x >= 0 : Ax <= b} with A, b >= 0 we study delayed floors built from smooth monotone ramps, which are smooth, monotone and superadditive on the nonnegative reals. We prove that the resulting cuts, over all nonnegative multipliers and all widths in (0,1], cut out exactly the Chvátal-Gomory (CG) closure, and that every such cut is implied by at most n+1 CG cuts. For rational data, networks with k sequential delayed-floor activations, nonnegative weights and access to earlier outputs generate exactly the rank-k closure. Consequently this smoothing never adds strength at any depth; for bounded problems the best scalar bound of a depth-k network equals the LP value over the rank-k closure; on finite right-hand-side domains, exact value-function depth is governed by an objective-specific rank that can be smaller than the hull rank; and a sharp accuracy-Lipschitz trade-off is attained by a valid piecewise-linear ramp. A fixed width can be strictly weaker. Finite exact-arithmetic checks and explicitly identified numerical checks supplement the proofs.}
}

@article{mirjalili2025resource,
  abbr={arXiv},
  title={Resource-Based Time and Cost Prediction in Project Networks: From Statistical Modeling to Graph Neural Networks},
  author={Mirjalili, Reza and Braghi, Behrad and Shadrokh Sikari, Shahram},
  journal={arXiv preprint arXiv:2511.15003},
